# Copy to .env.local for local dev with `vercel dev`, and set the same keys as
# Environment Variables in the Vercel project. Never commit real secrets.

# MongoDB connection string (from your MongoDB Atlas / Vercel integration)
MONGODB_URI=

# Optional: database name (defaults to "aiffected")
MONGODB_DB=aiffected

# Secret you choose — required to use the /admin moderation page
ADMIN_TOKEN=

# Optional: salt used when hashing commenter IPs for the rate guard
IP_SALT=
